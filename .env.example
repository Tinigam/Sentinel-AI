APP_ENV=development
APP_NAME=Sentinel-AI
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@db:5432/sentinel_ai
POSTGRES_DB=sentinel_ai
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
CORS_ORIGINS=http://localhost:5173
RSS_FEED_URL=https://news.google.com/rss/search?q=%E5%8E%9F%E7%A5%9E+OR+%E5%B4%A9%E5%9D%8F%EF%BC%9A%E6%98%9F%E7%A9%B9%E9%93%81%E9%81%93+OR+%E7%BB%9D%E5%8C%BA%E9%9B%B6+OR+%E9%B8%A3%E6%BD%AE+OR+%E6%98%8E%E6%97%A5%E6%96%B9%E8%88%9F+OR+%E7%BB%88%E6%9C%AB%E5%9C%B0+OR+%E5%B0%91%E5%A5%B3%E5%89%8D%E7%BA%BF2+OR+%E7%8E%8B%E8%80%85%E8%8D%A3%E8%80%80+OR+%E7%AC%AC%E4%BA%94%E4%BA%BA%E6%A0%BC+OR+%E6%97%A0%E7%95%8F%E5%A5%91%E7%BA%A6+OR+%E4%B8%89%E8%A7%92%E6%B4%B2%E8%A1%8C%E5%8A%A8&hl=zh-CN&gl=CN&ceid=CN%3Azh-Hans
RSS_SOURCE_NAME=Google News · Target Games
INGEST_API_KEY=local-dev-key
REQUEST_TIMEOUT_SECONDS=30
# Optional: logged-in Bilibili cookie (SESSDATA=...) to bypass anonymous risk
# control on the official account video list. Comments work without it.
BILIBILI_COOKIE=
BILIBILI_VIDEOS_PER_ACCOUNT=5
BILIBILI_COMMENTS_PER_VIDEO=15
# Deep comment crawl for distortion detection (newest video per account only).
# 25 pages x 20 comments = up to 500 comments; 0 disables the deep crawl.
BILIBILI_COMMENT_PAGES=25